# =========================================================================
# PUBLIC CONFIGURATION (Sent to client browser)
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =========================================================================
# PRIVATE SERVER-ONLY CONFIGURATION (NEVER expose to client browser)
# =========================================================================
# Service Role Key for server-side evaluation & grading (bypass RLS on server only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret PIN for HR Admin Dashboard access (Default if empty: 889922)
ADMIN_PIN=889922

# Secret salt key for signing admin session tokens
ADMIN_JWT_SECRET=replace-with-a-random-secure-secret-string
