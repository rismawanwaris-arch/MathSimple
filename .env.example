# =========================================================================
# PUBLIC CONFIGURATION (Sent to client browser)
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =========================================================================
# PRIVATE SERVER-ONLY CONFIGURATION (NEVER expose to client browser)
# =========================================================================
# Service Role Key for server-side evaluation & grading (bypass RLS on server only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# WAJIB: PIN HR Admin (tidak ada default; login admin nonaktif jika kosong). Gunakan minimal 8 karakter acak.
ADMIN_PIN=ganti-dengan-pin-kuat

# Disarankan: secret acak >= 32 karakter untuk menandatangani sesi admin (openssl rand -hex 32)
ADMIN_JWT_SECRET=replace-with-a-random-secure-secret-string
